{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.dev)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.ssh/**)",
      "Read(**/.claude/**)",
      "Read(**/*.pem)",
      "Read(**/id_ed25519*)",
      "Read(**/id_rsa*)",
      "Edit(**/.env*)",
      "Write(**/.env*)"
    ]
  }
}
